{
  "name": "ranil-design-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "description": "Ranil Mukesh MJ: constructivist portfolio at design.ranilmukesh.com, built on the MIT-licensed astro-constructivist template.",
  "author": "Ranil Mukesh MJ",
  "license": "MIT",
  "homepage": "https://design.ranilmukesh.com",
  "keywords": [
    "portfolio",
    "astro",
    "agentic-ai"
  ],
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run check-config && astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint --cache",
    "typecheck": "astro check",
    "knip": "knip",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "ci": "pnpm run schema:check && pnpm run check-config && pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test",
    "schema": "tsx scripts/generate-schema.mjs",
    "schema:check": "tsx scripts/generate-schema.mjs --check",
    "check-config": "tsx scripts/check-config.mjs",
    "art": "node scripts/generate-art.mjs"
  },
  "dependencies": {
    "@astrojs/check": "catalog:prod",
    "@astrojs/sitemap": "catalog:prod",
    "@fontsource-variable/jetbrains-mono": "catalog:prod",
    "@fontsource-variable/space-grotesk": "catalog:prod",
    "@fontsource/anton": "catalog:prod",
    "@fontsource/instrument-serif": "catalog:prod",
    "@iconify-json/mdi": "catalog:prod",
    "@iconify-json/ri": "catalog:prod",
    "@iconify-json/simple-icons": "catalog:prod",
    "@tailwindcss/vite": "catalog:prod",
    "astro": "catalog:prod",
    "gsap": "catalog:prod",
    "lenis": "catalog:prod",
    "sharp": "catalog:prod",
    "tailwindcss": "catalog:prod",
    "typescript": "catalog:prod",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@axe-core/playwright": "catalog:dev",
    "@playwright/test": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-astro": "catalog:dev",
    "eslint-plugin-slop": "catalog:dev",
    "eslint-plugin-sonarjs": "catalog:dev",
    "knip": "catalog:dev",
    "tsx": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
