---
import Footer from '@/components/Footer.astro'
import Credentials from '@/components/sections/Credentials.astro'
import { cv } from '@/data/cv'
import Layout from '@/layouts/Layout.astro'

const { name } = cv.basics
---
<Layout title={`Credentials · ${name}`} path="/credentials/" description="Awards, certifications, research identifiers and verified peer reviews for Ranil Mukesh MJ, each linked to the public page that confirms it.">
  <Credentials />
  <Footer />
</Layout>
