---
import type { cv } from '@/data/cv'
import Icon from '@/components/ui/Icon.astro'
import { text } from '@/data/site'
import { formatMonthYear } from '@/utils/date'

interface Props {
  paper: (typeof cv.publications)[number]
  index: number
}

const { paper, index } = Astro.props
const pad = (value: number) => String(value).padStart(2, '0')
---
<li class="paper" data-scroll>
  <span class="paper__index display" aria-hidden="true">{pad(index + 1)}</span>
  <div class="paper__body">
    <div class="paper__meta">
      {paper.publisher && <span class="stamp stamp--solid">{paper.publisher}</span>}
      {!paper.publisher && !paper.releaseDate && <span class="stamp">{text('research.preprint')}</span>}
      {paper.releaseDate && <span class="mono paper__date">{formatMonthYear(paper.releaseDate)}</span>}
    </div>
    <h3 class="paper__title">
      {paper.url
        ? <a class="link-line" href={paper.url} target="_blank" rel="noopener noreferrer">{paper.name}</a>
        : paper.name}
    </h3>
    {paper.summary && <p class="paper__abstract">{paper.summary}</p>}
    {paper.tags && paper.tags.length > 0 && (
      <ul class="paper__tags" aria-label={text('common.highlights')}>
        {paper.tags.map(tag => <li class="mono">{tag}</li>)}
      </ul>
    )}
    {(paper.url || paper.github) && (
      <div class="paper__links">
        {paper.url && (
          <a class="btn btn--solid" href={paper.url} target="_blank" rel="noopener noreferrer" aria-label={text('research.pdfLabel').replace('{name}', paper.name)} data-cursor={text('cursor.open')}>
            <Icon name="mdi:file-document-outline" width={15} height={15} aria-hidden="true" />
            {text('research.pdf')}
          </a>
        )}
        {paper.github && (
          <a class="arrow-link" href={paper.github} target="_blank" rel="noopener noreferrer" aria-label={text('common.sourceLabel').replace('{name}', paper.name)}>
            <Icon name="mdi:github" width={16} height={16} aria-hidden="true" />
            <span>{text('research.code')}</span>
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    )}
  </div>
</li>
