---
import PaperItem from '@/components/research/PaperItem.astro'
import Section from '@/components/Section.astro'
import PageCrumbs from '@/components/ui/PageCrumbs.astro'
import ViewAll from '@/components/ui/ViewAll.astro'
import { cv } from '@/data/cv'
import { text } from '@/data/site'
import { PAGES, VIEW_ALL_MODE } from '@/data/view-all'

interface Props {
  /** `home` shows three selected papers; `page` is the full archive at /research/. */
  variant?: 'home' | 'page'
}

const { variant = 'home' } = Astro.props
const papers = cv.publications
// Three selected papers keep the homepage section near one screen.
const flagged = papers.filter(paper => paper.featured)
const shown = variant === 'page'
  ? papers
  : (flagged.length > 0
      ? flagged
      : papers).slice(0, 3)
const rest = papers.filter(paper => !shown.includes(paper))
const pad = (value: number) => String(value).padStart(2, '0')
const venues = papers.filter(paper => paper.publisher).length
const meta = [
  `${pad(papers.length)} ${text('research.papers')}`,
  venues > 0 && `${pad(venues)} ${text('research.venues')}`,
].filter(Boolean).join(' · ')
const note = variant === 'page'
  ? text('research.notePage')
  : text('research.note')
---
<Section id="research" meta={meta}>
  <div class:list={['research', variant === 'page' && 'research--page']}>
    {variant === 'page' && <PageCrumbs current="research" section="research" />}
    <header class="research__head" data-scroll>
      <div>
        <p class="kicker">{text('research.intro')}</p>
        <p class="research__statement">{text('research.statementFirst')}<br /><em>{text('research.statementLast')}</em></p>
      </div>
      <p class="research__note mono">{note}</p>
    </header>

    <ol class="papers">
      {shown.map(paper => <PaperItem paper={paper} index={papers.indexOf(paper)} />)}
    </ol>

    {variant === 'home' && rest.length > 0 && (
      <ViewAll
        mode={VIEW_ALL_MODE}
        href={PAGES.research}
        label={text('research.allCount').replace('{count}', String(papers.length))}
        note={VIEW_ALL_MODE === 'pages'
          ? text('viewAll.page')
          : text('viewAll.more').replace('{count}', String(rest.length))}
      >
        <ol class="papers">
          {rest.map(paper => <PaperItem paper={paper} index={papers.indexOf(paper)} />)}
        </ol>
      </ViewAll>
    )}
  </div>
</Section>

<style is:global>
  @import "../../styles/sections/research.css";
</style>
