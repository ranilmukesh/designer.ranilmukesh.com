---
import Section from '@/components/Section.astro'
import PageCrumbs from '@/components/ui/PageCrumbs.astro'
import ViewAll from '@/components/ui/ViewAll.astro'
import ArticleItem from '@/components/writing/ArticleItem.astro'
import { cv } from '@/data/cv'
import { text } from '@/data/site'
import { PAGES, VIEW_ALL_MODE } from '@/data/view-all'

interface Props {
  /** `home` shows the three latest articles; `page` lists every article at /writing/. */
  variant?: 'home' | 'page'
}

const { variant = 'home' } = Astro.props
const articles = [...cv.articles].sort((a, b) => b.date.localeCompare(a.date))
const shown = variant === 'page'
  ? articles
  : articles.slice(0, 3)
const rest = articles.slice(shown.length)
const pad = (value: number) => String(value).padStart(2, '0')
const meta = `${pad(articles.length)} ${text('writing.articles')}`
---
<Section id="writing" meta={meta}>
  <div class="writing">
    {variant === 'page' && <PageCrumbs current="writing" section="writing" />}
    <header class="writing__head" data-scroll>
      <div>
        <p class="kicker">{text('writing.intro')}</p>
        <p class="writing__statement">{text('writing.statementFirst')}<br /><em>{text('writing.statementLast')}</em></p>
      </div>
      <p class="writing__note mono">{text('writing.note')}</p>
    </header>

    <ol class="articles">
      {shown.map(article => <ArticleItem article={article} index={articles.indexOf(article)} />)}
    </ol>

    {variant === 'home' && rest.length > 0 && (
      <ViewAll
        mode={VIEW_ALL_MODE}
        href={PAGES.writing}
        label={text('writing.allCount').replace('{count}', String(articles.length))}
        note={VIEW_ALL_MODE === 'pages'
          ? text('viewAll.page')
          : text('viewAll.more').replace('{count}', String(rest.length))}
      >
        <ol class="articles">
          {rest.map(article => <ArticleItem article={article} index={articles.indexOf(article)} />)}
        </ol>
      </ViewAll>
    )}
  </div>
</Section>

<style is:global>
  @import "../../styles/sections/writing.css";
</style>
