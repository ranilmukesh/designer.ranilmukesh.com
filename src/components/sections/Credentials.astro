---
import ProofBand from '@/components/proof/ProofBand.astro'
import Section from '@/components/Section.astro'
import PageCrumbs from '@/components/ui/PageCrumbs.astro'
import { cv } from '@/data/cv'
import { text } from '@/data/site'
import { formatMonthYear } from '@/utils/date'

const featured = cv.certificates.filter(certificate => certificate.featured)
const certificates = [
...featured,
...cv.certificates.filter(certificate => !certificate.featured),
]
const meta = [
  `${String(cv.awards.length).padStart(2, '0')} ${text('credentials.awards')}`,
  `${String(cv.certificates.length).padStart(2, '0')} ${text('credentials.certificates')}`,
].join(' · ')
---
<Section id="credentials" meta={meta}>
  <PageCrumbs current="credentials" section="about" />
  <p class="credentials__intro">{text('credentials.intro')}</p>

  <ProofBand variant="page" />

  <section class="credentials__block" aria-labelledby="credentials-awards">
    <h3 id="credentials-awards" class="credentials__block-title display">{text('credentials.awards')}</h3>
    <ul class="credentials__list">
      {cv.awards.map(award => (
        <li>
          <span class="credentials__name">{award.title}</span>
          <span class="credentials__meta">{[award.awarder, award.date && formatMonthYear(award.date), award.summary].filter(Boolean).join(' · ')}</span>
          {award.url && <a class="credentials__link" href={award.url} target="_blank" rel="noopener noreferrer">{text('proof.verify')} ↗</a>}
        </li>
      ))}
    </ul>
  </section>

  <section class="credentials__block" aria-labelledby="credentials-certificates">
    <h3 id="credentials-certificates" class="credentials__block-title display">{text('credentials.certificates')}</h3>
    <ul class="credentials__list">
      {certificates.map(certificate => (
        <li>
          <span class="credentials__name">{certificate.name}</span>
          <span class="credentials__meta">{[certificate.issuer, certificate.date && formatMonthYear(certificate.date)].filter(Boolean).join(' · ')}</span>
          {certificate.url && <a class="credentials__link" href={certificate.url} target="_blank" rel="noopener noreferrer">{text('proof.verify')} ↗</a>}
        </li>
      ))}
    </ul>
  </section>

  <section class="credentials__block" aria-labelledby="credentials-identifiers">
    <h3 id="credentials-identifiers" class="credentials__block-title display">{text('credentials.identifiers')}</h3>
    <ul class="credentials__list">
      {cv.identifiers.map(id => (
        <li>
          <span class="credentials__name">{id.name}</span>
          <span class="credentials__meta mono">{id.value}</span>
          <a class="credentials__link" href={id.url} target="_blank" rel="noopener noreferrer">{text('proof.verify')} ↗</a>
        </li>
      ))}
    </ul>
  </section>

  {cv.education.length > 0 && (
    <section class="credentials__block" aria-labelledby="credentials-education">
      <h3 id="credentials-education" class="credentials__block-title display">{text('credentials.education')}</h3>
      <ul class="credentials__list">
        {cv.education.map(school => (
          <li>
            <span class="credentials__name">{school.studyType}, {school.area}</span>
            <span class="credentials__meta">{school.institution}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Section>
